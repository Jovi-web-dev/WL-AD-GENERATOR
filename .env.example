# ============================================================
# Ad Generator — variaveis de ambiente
# ------------------------------------------------------------
# Copie este arquivo para `.env` e preencha com valores reais.
# NUNCA commite `.env`.
# ============================================================

# --- Obrigatorias ---

# String de conexao PostgreSQL. No Replit e injetada automaticamente
# quando voce cria o Postgres nativo.
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Chave de assinatura dos JWT de sessao.
# Gerar com: openssl rand -hex 32
# Obrigatoria em producao (NODE_ENV=production).
JWT_SECRET=

# --- Opcionais ---

# Ambiente de execucao. Default: development.
NODE_ENV=development

# Porta HTTP do servidor. Default: 5000.
PORT=5000

# ============================================================
# Observacoes importantes sobre chaves de IA (Anthropic, Google, fal.ai)
# ------------------------------------------------------------
# O projeto adota BYOK (Bring Your Own Key): cada cliente cadastra
# suas proprias chaves na plataforma, criptografadas no banco.
#
# Nao configure chaves de IA aqui. A partir da Etapa 2 da refatoracao,
# chaves por usuario serao gerenciadas pelo CredentialsVault.
#
# Variaveis legadas ainda lidas pelo codigo atual (serao removidas):
#   ANTHROPIC_API_KEY, ANTHROPIC_MODEL,
#   GOOGLE_IMAGE_API_KEY, GOOGLE_VERTEX_SERVICE_ACCOUNT,
#   VEO3_API_KEY, GOOGLE_VIDEO_API_KEY
# ============================================================
